{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "reno://structured/schema/concept.schema.json",
  "title": "RENO Concept Page Frontmatter",
  "description": "Minimal flat YAML frontmatter for Phase 3 concept pages under wiki/concept/. Reasoning, evidence, and source support belong in the markdown body, not metadata.",
  "type": "object",
  "required": [
    "id",
    "type",
    "status",
    "phase",
    "parent",
    "prev",
    "next"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": ["concept"]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "candidate",
        "deprecated",
        "needs-review"
      ]
    },
    "phase": {
      "type": "string",
      "enum": ["phase-3-reasoned"]
    },
    "parent": {
      "type": ["string", "null"]
    },
    "prev": {
      "type": ["string", "null"]
    },
    "next": {
      "type": ["string", "null"]
    },
    "title": {
      "type": "string",
      "minLength": 1
    }
  }
}
